NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Accounts and server-side project sync (v2, backend only)
# Postgres. For Supabase use the *Transaction pooler* string (port 6543) from
# Project -> Connect. Local development: any Postgres, e.g. the URL below.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/codementor"
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_COOKIE_NAME=codementor_session
SESSION_TTL_DAYS=7

# AI Deep Help (backend only — never expose these to the browser)
# Google AI Studio keys use Gemini's native API adapter; choose a model currently enabled for your account.
AI_API_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_API_TIMEOUT_MS=30000

AI_DAILY_LIMIT=3
AI_COOLDOWN_SECONDS=30
AI_CACHE_TTL_SECONDS=86400
AI_MAX_SOURCE_CHARS=12000
AI_MAX_CONTEXT_LINES=80

RUN_TIMEOUT_MS=3000
MAX_CODE_SIZE_BYTES=51200
MAX_STDIN_SIZE_BYTES=10240

# Secure remote execution (backend only)
# EXECUTION_PROVIDER selects the built-in keyless adapter:
#   judge0 — default. Judge0 CE (https://ce.judge0.com) serves every language
#            CodeMentor offers, including Kotlin.
#   piston — the Piston adapter. The public Piston API
#            (https://emkc.org/api/v2/piston) became whitelist-only on
#            2026-02-15 and returns HTTP 401 for anonymous use; point
#            EXECUTION_API_BASE_URL at your own Piston instance instead.
EXECUTION_PROVIDER=judge0
EXECUTION_API_BASE_URL=https://ce.judge0.com
EXECUTION_API_KEY=
EXECUTION_API_TIMEOUT_MS=15000

EXECUTION_DAILY_LIMIT=20
EXECUTION_COOLDOWN_SECONDS=5
EXECUTION_MAX_OUTPUT_BYTES=100000

# Multi-file project limits (v2)
EXECUTION_MAX_FILES=30
EXECUTION_MAX_PROJECT_BYTES=512000
EXECUTION_MAX_FILE_BYTES=51200
