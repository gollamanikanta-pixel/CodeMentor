{
  "name": "codementor-server",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node scripts/copy-schema.mjs",
    "start": "node dist/index.js",
    "check": "tsc --noEmit",
    "db:generate": "tsx src/db/generate.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "test": "tsx --test src/utils/hash.test.ts src/tests/auth.test.ts src/tests/authFlowGuard.test.ts src/tests/providers.test.ts src/tests/pathSafety.test.ts src/tests/validatorsAndCache.test.ts src/tests/pistonNormalizer.test.ts src/tests/judge0Normalizer.test.ts src/tests/aiService.test.ts src/tests/settingsRoutes.test.ts src/tests/quizRoutes.test.ts"
  },
  "dependencies": {
    "bcryptjs": "latest",
    "cookie-parser": "latest",
    "cors": "latest",
    "dotenv": "latest",
    "express": "latest",
    "express-rate-limit": "latest",
    "helmet": "latest",
    "pg": "^8.13.1",
    "ws": "^8.18.0",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/cookie-parser": "latest",
    "@types/cors": "latest",
    "@types/express": "latest",
    "@types/node": "latest",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.5.13",
    "tsx": "latest",
    "typescript": "latest"
  }
}
