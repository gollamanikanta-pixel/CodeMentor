NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# SQLite (node:sqlite, no ORM). The file is git-ignored.
DATABASE_URL="file:./data/codementor.db"

# Sessions — generate a long random value for SESSION_SECRET, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_COOKIE_NAME=codementor_session
SESSION_TTL_DAYS=7

# AI Deep Help (optional, backend only — never expose these to the browser).
# Leave AI_API_BASE_URL empty to keep AI Deep Help disabled; local guidance,
# visuals and quizzes never need it. Google AI Studio keys use Gemini's native
# API adapter on the backend; a verified Flash model is gemini-3.5-flash.
AI_API_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_API_TIMEOUT_MS=30000
AI_DAILY_LIMIT=3
AI_COOLDOWN_SECONDS=30
AI_CACHE_TTL_SECONDS=86400
AI_MAX_SOURCE_CHARS=12000
AI_MAX_CONTEXT_LINES=80

# Browser runner limits (mirrored server-side for validation).
RUN_TIMEOUT_MS=3000
MAX_CODE_SIZE_BYTES=51200
MAX_STDIN_SIZE_BYTES=10240

# Secure remote execution for compiled languages (backend only).
# Default: Judge0 CE — keyless, and the only free runner that publishes a
# runtime for every language CodeMentor offers (C, C++, Java, C#, Go, PHP, Ruby,
# Rust, Kotlin). Nothing is uploaded from the browser; the backend calls it.
# Alternative: set EXECUTION_PROVIDER=piston with your own Piston base URL — the
# public Piston API became whitelist-only on 2026-02-15 and returns HTTP 401.
EXECUTION_PROVIDER=judge0
EXECUTION_API_BASE_URL=https://ce.judge0.com

# When a non-Judge0 provider refuses to execute anonymous code (e.g. the public
# Piston API), retry the same unmodified source on Judge0 CE. Set to false to
# disable the retry and report the refusal instead.
EXECUTION_JUDGE0_FALLBACK=true
EXECUTION_API_KEY=
EXECUTION_API_TIMEOUT_MS=15000
EXECUTION_DAILY_LIMIT=50
EXECUTION_COOLDOWN_SECONDS=3
EXECUTION_MAX_OUTPUT_BYTES=200000
EXECUTION_MAX_FILES=30
EXECUTION_MAX_PROJECT_BYTES=512000
EXECUTION_MAX_FILE_BYTES=51200

# Live interactive terminal runner (separate service; requires an E2B API key).
# Configure RUNNER_SHARED_SECRET in runner/.env to the same private value.
TERMINAL_RUNNER_URL=ws://127.0.0.1:5101/session
TERMINAL_RUNNER_SECRET=
TERMINAL_RUNNER_TIMEOUT_MS=70000
TERMINAL_RUNNER_MAX_OUTPUT_BYTES=200000
